# WeCare Hospital — Apache Web Server Configuration
# Ensures PHP files are properly executed, index.php is loaded at root, and sensitive files are protected.

# 1. Default Index File
DirectoryIndex index.php index.html

# 2. Ensure PHP Execution (Prevents PHP files from downloading as raw text/files)
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# 3. Security: Block Access to Sensitive Files & Configuration
<FilesMatch "^(\.env|\.git|schema\.sql|ensure-mysql\.bat|run-php-server\.bat|serve\.bat|serve\.ps1|Dockerfile|docker-entrypoint\.sh|render\.yaml|\.vscode)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. Disable Directory Browsing
Options -Indexes

# 5. Enable URL Rewriting & Clean Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure root loads index.php
    RewriteRule ^$ index.php [L]

    # If the requested file or directory exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

# 6. Default Charset & Security Headers
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
