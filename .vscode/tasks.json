{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PHP: Start built-in server",
            "type": "shell",
            "command": "php",
            "args": ["-S", "127.0.0.1:5500", "-t", "${workspaceFolder}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "${workspaceFolder}\\run-php-server.bat",
                "args": [],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "php-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Development Server .* started"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
